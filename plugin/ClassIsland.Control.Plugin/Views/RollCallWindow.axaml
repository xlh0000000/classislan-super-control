<Window
    x:Class="ClassIsland.Control.Plugin.Views.RollCallWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="点名"
    Width="260" Height="112"
    Background="Transparent"
    TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
    WindowDecorations="None"
    CanResize="False"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    WindowStartupLocation="Manual">
  <!-- 毛玻璃交给系统亚克力合成（不透明度可调），窗口里不再叠一层高不透明度的白色，
       也不放标题、名单等文字：内容只有下面两个 Fluent 按钮。 -->
  <ExperimentalAcrylicBorder x:Name="Shell" Margin="6" CornerRadius="18">
    <ExperimentalAcrylicBorder.Material>
      <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                   TintColor="White" TintOpacity="0.4" MaterialOpacity="0.55"
                                   FallbackColor="#E6FFFFFF"/>
    </ExperimentalAcrylicBorder.Material>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="10">
      <Button x:Name="SingleButton" Classes="accent" Content="抽人" Click="SingleButton_OnClick"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              FontSize="16"/>
      <Button x:Name="MultiButton" Grid.Column="1" Content="多人" Click="MultiButton_OnClick"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              FontSize="16"/>
    </Grid>
  </ExperimentalAcrylicBorder>
</Window>