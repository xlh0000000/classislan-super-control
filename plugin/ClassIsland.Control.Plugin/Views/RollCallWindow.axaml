<Window
    x:Class="ClassIsland.Control.Plugin.Views.RollCallWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="点名"
    Width="260" Height="112"
    Background="Transparent"
    TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
    SystemDecorations="None"
    CanResize="False"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    WindowStartupLocation="Manual">
  <!-- 贡献者：威廉（抽人悬浮窗：真毛玻璃 + DWM 圆角 + 只有按钮里的字）
       亚克力铺满整窗、不留边距，圆角由 Win11 DWM 裁剪（代码里动态设置）。
       窗口底色永远是浅色，跟随主题的按钮会在浅底上出现白字（“多人”的老问题），
       所以两个按钮的面与字都自己画，不依赖主题配色。 -->
  <Window.Styles>
    <Style Selector="TextBlock.draw-text">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>
  <ExperimentalAcrylicBorder x:Name="Shell" Margin="0" CornerRadius="8">
    <ExperimentalAcrylicBorder.Material>
      <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                   TintColor="White" TintOpacity="0.2" MaterialOpacity="0.44"
                                   FallbackColor="#CCFFFFFF"/>
    </ExperimentalAcrylicBorder.Material>
    <Grid x:Name="Layout" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="12">
      <!-- 抽人：宿主强调色（accent）实心面 + 显式白字 -->
      <Button x:Name="SingleButton" Classes="accent" Click="SingleButton_OnClick"
              Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TextBlock x:Name="SingleText" Classes="draw-text" Text="抽人" Foreground="#FFFFFFFF"/>
      </Button>
      <!-- 多人：深色实心面 + 浅字，面画在内容里，主题换不掉 -->
      <Button x:Name="MultiButton" Grid.Column="1" Click="MultiButton_OnClick"
              Background="Transparent" BorderThickness="0" Padding="0"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Border x:Name="MultiShell" Background="#F2252820" BorderBrush="#40FFFFFF"
                BorderThickness="1" CornerRadius="8">
          <TextBlock x:Name="MultiText" Classes="draw-text" Text="多人" Foreground="#FFF0EEE5"/>
        </Border>
      </Button>
    </Grid>
  </ExperimentalAcrylicBorder>
</Window>