<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 贡献者：威廉
       莱茵主题：与网页集控端同一套设计语言。
       暖米白纸面、近黑文字、全部直角、1px 发丝分隔线、深橄榄主填充、暖杏金强调。
       只给设置页用的行式排版，不改动宿主与 FluentAvalonia 的既有控件外观。 -->
  <Styles.Resources>
    <SolidColorBrush x:Key="RhinePaper" Color="#EDEAE3"/>
    <SolidColorBrush x:Key="RhineLine" Color="#D6D0C4"/>
    <SolidColorBrush x:Key="RhineLineStrong" Color="#BFB7A7"/>
    <SolidColorBrush x:Key="RhineInk" Color="#080A08"/>
    <SolidColorBrush x:Key="RhineInkSoft" Color="#5A584E"/>
    <SolidColorBrush x:Key="RhineInkMuted" Color="#888074"/>
    <SolidColorBrush x:Key="RhineWash" Color="#E2DCCF"/>
  </Styles.Resources>

  <!-- 一组设置：只靠底部一条深发丝线收口，不做卡片圆角。 -->
  <Style Selector="Border.rhine">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource RhineLineStrong}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,18"/>
  </Style>

  <!-- 组内一行：上边一条浅发丝线作分隔，最后一行与组底线相接也不重叠。 -->
  <Style Selector="Border.rhine-row">
    <Setter Property="BorderBrush" Value="{StaticResource RhineLine}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0,14"/>
  </Style>
  <Style Selector="Border.rhine-row:first-child">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <Style Selector="TextBlock.rhine-label">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource RhineInkSoft}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="TextBlock.rhine-value">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource RhineInkMuted}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- 行内次级按钮：直角发丝描边，悬停转暖杏金。 -->
  <Style Selector="TextBlock.rhine-hint">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource RhineInkMuted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="Button.rhine-ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource RhineLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource RhineInkSoft}"/>
  </Style>
  <Style Selector="Button.rhine-ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource RhineWash}"/>
    <Setter Property="BorderBrush" Value="{StaticResource RhineLineStrong}"/>
    <Setter Property="TextBlock.Foreground" Value="{StaticResource RhineInk}"/>
  </Style>
</Styles>