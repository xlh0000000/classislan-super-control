<ci:SettingsPageBase
    x:Class="ClassIsland.Control.Plugin.Views.ControlSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:c="clr-namespace:ClassIsland.Control.Plugin.Views.Controls"
    mc:Ignorable="d"
    d:DesignWidth="800" d:DesignHeight="600">
  <ScrollViewer>
    <StackPanel Classes="settings-container animated-intro">

      <!-- SDK 2.1.0.1 的宿主里没有 FAInfoBar，两条提示改用自带的 Border+TextBlock 画。 -->
      <Border x:Name="ErrorBar" IsVisible="False" BorderThickness="1" BorderBrush="#8C3040"
              Background="#148C3040" CornerRadius="6" Padding="12,10">
        <TextBlock x:Name="ErrorBarText" Foreground="#8C3040" TextWrapping="Wrap"/>
      </Border>

      <Border x:Name="ManagedNotice" IsVisible="False" BorderThickness="1" BorderBrush="#737C74"
              Background="#0F737C74" CornerRadius="6" Padding="12,10">
        <StackPanel Spacing="2">
          <TextBlock Text="已由集控端接管" FontWeight="SemiBold"/>
          <TextBlock Text="除集控端主动解除外，本机无法退出集控，也无法更改服务器地址或设备身份。"
                     Opacity="0.75" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <StackPanel Classes="cardContainer">
        <c:SettingRow Content="接入状态">
          <c:SettingRow.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center" Fill="#737C74"/>
              <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="380"
                         VerticalAlignment="Center" Text="未加入集控"/>
            </StackPanel>
          </c:SettingRow.Footer>
        </c:SettingRow>
      </StackPanel>

      <StackPanel Classes="cardContainer" x:Name="DetailPanel" IsVisible="False">
        <c:SettingRow>
          <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
            <TextBlock Text="设备 ID" Opacity="0.6"/>
            <TextBlock Grid.Column="1" x:Name="DeviceIdText" TextWrapping="Wrap"/>
          </Grid>
        </c:SettingRow>
        <c:SettingRow>
          <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
            <TextBlock Text="服务器" Opacity="0.6"/>
            <TextBlock Grid.Column="1" x:Name="ServerText" TextWrapping="Wrap"/>
          </Grid>
        </c:SettingRow>
        <c:SettingRow>
          <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
            <TextBlock Text="连接方式" Opacity="0.6"/>
            <TextBlock Grid.Column="1" x:Name="TransportText" TextWrapping="Wrap"/>
          </Grid>
        </c:SettingRow>
        <c:SettingRow>
          <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
            <TextBlock Text="时间偏移" Opacity="0.6"/>
            <TextBlock Grid.Column="1" x:Name="TimeOffsetText" TextWrapping="Wrap"/>
          </Grid>
        </c:SettingRow>
        <c:SettingRow>
          <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
            <TextBlock Text="最近同步" Opacity="0.6"/>
            <TextBlock Grid.Column="1" x:Name="LastSyncText" TextWrapping="Wrap"/>
          </Grid>
        </c:SettingRow>
        <c:SettingRow>
          <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
            <TextBlock Text="已应用策略" Opacity="0.6"/>
            <TextBlock Grid.Column="1" x:Name="PolicyText" TextWrapping="Wrap"/>
          </Grid>
        </c:SettingRow>
      </StackPanel>

      <StackPanel Classes="cardContainer" x:Name="LockPanel" IsVisible="False">
        <c:SettingRow>
          <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
            <TextBlock Text="集控端锁定" Opacity="0.6"/>
            <TextBlock Grid.Column="1" x:Name="LockText" TextWrapping="Wrap"/>
          </Grid>
        </c:SettingRow>
      </StackPanel>

      <StackPanel Classes="cardContainer">
        <c:SettingRow Content="课表上传" Description="自动采集本机课表档案（课表、时间表、科目、课表群）并上报到集控端，本机改动会自动重传。">
          <c:SettingRow.Footer>
            <ToggleSwitch x:Name="TimetableUploadSwitch" OnContent="已开启" OffContent="已关闭"/>
          </c:SettingRow.Footer>
        </c:SettingRow>
        <c:SettingRow Content="上传状态">
          <c:SettingRow.Footer>
            <TextBlock x:Name="TimetableStatusText" VerticalAlignment="Center" TextAlignment="Right"
                       MaxWidth="420" TextWrapping="Wrap" Text="尚未同步"/>
          </c:SettingRow.Footer>
        </c:SettingRow>
        <c:SettingRow Content="崩溃上报" Description="本机未处理异常会记录并在下次连接时上报给集控端。">
          <c:SettingRow.Footer>
            <TextBlock x:Name="CrashStatusText" VerticalAlignment="Center" TextAlignment="Right"
                       MaxWidth="420" TextWrapping="Wrap" Text="本机无崩溃记录"/>
          </c:SettingRow.Footer>
        </c:SettingRow>
        <c:SettingRow Content="插件升级" Description="集控端下发新版本后，本机在没课时自动重启完成升级。">
          <c:SettingRow.Footer>
            <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" TextAlignment="Right"
                       MaxWidth="420" TextWrapping="Wrap" Text="尚未同步"/>
          </c:SettingRow.Footer>
        </c:SettingRow>
      </StackPanel>

      <StackPanel Classes="cardContainer" x:Name="ConnectPanel">
        <c:SettingRow Content="服务器地址" Description="集控服务端地址，支持 http:// 与 https://。">
          <c:SettingRow.Footer>
            <TextBox x:Name="ServerUrlBox" MinWidth="240" MaxWidth="320"
                     Watermark="https://control.example.edu"/>
          </c:SettingRow.Footer>
        </c:SettingRow>
        <c:SettingRow Content="设备名称" Description="在集控端设备列表中显示的名称。">
          <c:SettingRow.Footer>
            <TextBox x:Name="DeviceNameBox" MinWidth="240" MaxWidth="320"/>
          </c:SettingRow.Footer>
        </c:SettingRow>
        <c:SettingRow Content="一次性接入码" Description="首次注册时填写；注册成功后由集控端管理。">
          <c:SettingRow.Footer>
            <TextBox x:Name="EnrollmentTokenBox" PasswordChar="●" MinWidth="240" MaxWidth="320"
                     Watermark="首次注册填写"/>
          </c:SettingRow.Footer>
        </c:SettingRow>
        <c:SettingRow Content="接入集控">
          <c:SettingRow.Footer>
            <Button x:Name="SaveButton" Classes="accent" Content="保存并连接" Click="SaveButton_OnClick"/>
          </c:SettingRow.Footer>
        </c:SettingRow>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</ci:SettingsPageBase>