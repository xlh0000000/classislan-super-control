<Window
    x:Class="ClassIsland.Control.Plugin.Views.RollCallResultWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="点名结果"
    SizeToContent="WidthAndHeight"
    Background="Transparent"
    TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
    WindowDecorations="None"
    CanResize="False"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen">
  <!-- 与抽人悬浮窗同一套毛玻璃：系统亚克力 + 只显示姓名，不放标题等其他文字。 -->
  <ExperimentalAcrylicBorder x:Name="Card" Margin="26" CornerRadius="26" Opacity="0">
    <ExperimentalAcrylicBorder.Material>
      <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                   TintColor="White" TintOpacity="0.5" MaterialOpacity="0.7"
                                   FallbackColor="#F2FFFFFF"/>
    </ExperimentalAcrylicBorder.Material>
    <WrapPanel x:Name="NameList" Orientation="Horizontal" HorizontalAlignment="Center"
               Margin="54,32"/>
  </ExperimentalAcrylicBorder>
</Window>