<Window
    x:Class="ClassIsland.Control.Plugin.Views.RollCallResultWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="点名结果"
    SizeToContent="WidthAndHeight"
    Background="Transparent"
    TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
    SystemDecorations="None"
    CanResize="False"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen">
  <!-- 贡献者：威廉（点名结果窗：亚克力铺满整窗，圆角由 Win11 DWM 裁剪，只显示姓名；
       不设初始 Opacity=0——可见性由代码里可靠的补间控制，避免动画时钟不推进导致名字隐形） -->
  <ExperimentalAcrylicBorder x:Name="Card" Margin="0" CornerRadius="8">
    <ExperimentalAcrylicBorder.Material>
      <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                   TintColor="White" TintOpacity="0.2" MaterialOpacity="0.45"
                                   FallbackColor="#E6FFFFFF"/>
    </ExperimentalAcrylicBorder.Material>
    <WrapPanel x:Name="NameList" Orientation="Horizontal" HorizontalAlignment="Center"
               Margin="80,58"/>
  </ExperimentalAcrylicBorder>
</Window>